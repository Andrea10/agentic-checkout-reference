[24.8,"o","    2026-10-25T09:00:00.000Z  refuse            895 GBP  agent-buyer-1 -> merchant-demo  mandate 33333333-3333-4333-8333-333333333333  signature_invalid\r\n"]
[25.1,"o","  money        0 rail calls; spent £40.90 (4090 pence), unchanged\r\n"]
